---
// Design System: Pendopo & Peta Kota — formal local guide layout, no generic template chrome.
import "../styles/global.css";
import "../styles/professional-guide.css";
interface Props { title: string; description: string; pathname?: string; lang?: "id" | "en"; }
const { title, description, pathname = "/", lang = "id" } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(pathname, site).toString() : undefined;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#245C45" /><meta name="robots" content="index, follow" />{canonical && <link rel="canonical" href={canonical} />}<link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon-32.svg" sizes="32x32" type="image/svg+xml" /><link rel="icon" href="/favicon-16.svg" sizes="16x16" type="image/svg+xml" /><link rel="apple-touch-icon" href="/apple-touch-icon.svg" sizes="180x180" /><link rel="manifest" href="/site.webmanifest" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />{canonical && <meta property="og:url" content={canonical} />}<title>{title}</title><slot name="head" /></head><body><a class="skip-link" href="#konten">{lang === "en" ? "Skip to content" : "Langsung ke isi"}</a><slot /><script is:inline>(()=>{const KEY="aapg-analytics-consent";const start=()=>{if(document.querySelector("script[data-aapg-ga]"))return;const tag=document.createElement("script");tag.async=true;tag.src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP";tag.dataset.aapgGa="true";document.head.appendChild(tag);window.dataLayer=window.dataLayer||[];function gtag(){window.dataLayer.push(arguments)}gtag("js",new Date());gtag("config","G-HXM22WWPKP",{anonymize_ip:true})};if(localStorage.getItem(KEY)==="granted")start()})();</script></body></html>
