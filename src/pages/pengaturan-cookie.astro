---
// Design System: Pendopo & Peta Kota — consent controls are a full page, never a modal interruption.
import BaseLayout from "../layouts/BaseLayout.astro"; import Header from "../components/Header.astro"; import Footer from "../components/Footer.astro";
---
<BaseLayout title="Pengaturan Cookie — Alun-Alun Pandeglang" description="Atur preferensi cookie untuk Panduan Alun-Alun Pandeglang."><div class="site-shell"><Header /><main id="konten" class="cookie-page"><p class="eyebrow">Privasi Anda</p><h1>Pengaturan Cookie</h1><p class="intro">Kami menggunakan cookie minimum untuk menjalankan situs dan, jika Anda setujui, memahami penggunaan secara agregat.</p><div class="cookie-layout"><section class="cookie-list" aria-label="Pilihan cookie"><article><div><p class="tag">Wajib</p><h2>Cookie esensial</h2><p>Cookie ini diperlukan agar preferensi dasar dan fungsi situs dapat bekerja. Tidak dapat dinonaktifkan.</p></div><span class="always">Selalu aktif</span></article><article><div><p class="tag">Analitik</p><h2>Google Analytics</h2><p>Jika diaktifkan, data penggunaan anonim membantu kami memahami halaman yang berguna. Pelacakan hanya dimulai setelah persetujuan.</p></div><label class="switch"><input id="analytics" type="checkbox" /><span></span><b class="sr-only">Aktifkan cookie analitik</b></label></article><article><div><p class="tag">Preferensi</p><h2>Preferensi pengguna</h2><p>Memungkinkan situs mengingat pilihan cookie Anda di perangkat ini.</p></div><span class="always">Aktif bila disimpan</span></article><article class="off"><div><p class="tag">Pemasaran</p><h2>Iklan yang dipersonalisasi</h2><p>Situs ini tidak menjalankan cookie pemasaran atau iklan yang dipersonalisasi.</p></div><span class="always">Tidak digunakan</span></article></section><aside><p class="eyebrow">Persetujuan</p><h2>Anda selalu dapat mengubah pilihan.</h2><p>Menonaktifkan analitik tidak memengaruhi kemampuan untuk membaca panduan atau menggunakan peta sematan.</p><button id="save" class="save">Simpan preferensi</button><button id="reject" class="reject">Tolak semua non-esensial</button><p id="status" class="status" aria-live="polite"></p></aside></div></main><Footer /></div><script is:inline>const key="aapg-analytics-consent";const checkbox=document.querySelector("#analytics");const status=document.querySelector("#status");const message=(text)=>{if(status)status.textContent=text};if(checkbox&&localStorage.getItem(key)==="granted")checkbox.checked=true;document.querySelector("#save")?.addEventListener("click",()=>{localStorage.setItem(key,checkbox?.checked?"granted":"denied");message("Preferensi tersimpan. Muat ulang halaman untuk menerapkan perubahan analitik.")});document.querySelector("#reject")?.addEventListener("click",()=>{if(checkbox)checkbox.checked=false;localStorage.setItem(key,"denied");message("Cookie non-esensial telah ditolak.")});</script></BaseLayout>
<style>/* Design System: Pendopo & Peta Kota — preference controls follow the page’s institutional editorial tone. */.cookie-page{padding:clamp(4rem,9vw,7rem) clamp(1.25rem,10vw,10rem);background:rgba(251,249,244,.9)}h1{max-width:12ch;margin:.8rem 0 1rem;font-size:clamp(3rem,7vw,6rem)}.intro{max-width:55ch;color:var(--ink-soft);font-size:1.05rem}.cookie-layout{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(2rem,8vw,8rem);margin-top:4rem}.cookie-list{border-top:1px solid var(--line)}.cookie-list article{display:grid;grid-template-columns:1fr auto;gap:1rem;padding:1.55rem 0;border-bottom:1px solid var(--line)}.tag{color:var(--green);font-size:.64rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.cookie-list h2,aside h2{margin-top:.4rem;font-size:1.75rem}.cookie-list article p:last-child,aside>p:not(.eyebrow){margin-top:.55rem;color:var(--ink-soft);font-size:.83rem}.always{align-self:start;padding:.35rem .55rem;color:var(--green);background:var(--green-pale);font-size:.65rem;font-weight:800}.off .always{color:var(--ink-soft);background:rgba(24,35,30,.08)}.switch{position:relative;align-self:start;width:3.2rem;height:1.85rem}.switch input{position:absolute;opacity:0}.switch span{position:absolute;inset:0;border-radius:999px;background:#b9c6bc;transition:background .18s var(--ease-out)}.switch span::after{position:absolute;top:.23rem;left:.23rem;width:1.39rem;height:1.39rem;border-radius:50%;content:"";background:white;box-shadow:0 2px 4px rgba(0,0,0,.12);transition:transform .18s var(--ease-out)}.switch input:checked+span{background:var(--green)}.switch input:checked+span::after{transform:translateX(1.35rem)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.cookie-layout aside{align-self:start;padding:1.5rem;background:var(--green);color:white}.cookie-layout aside .eyebrow{color:#f0c07e}.cookie-layout aside>p:not(.eyebrow){color:rgba(255,255,255,.75)}.save,.reject{width:100%;margin-top:1.5rem;border:0;padding:.9rem;font:inherit;font-size:.72rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;cursor:pointer}.save{color:var(--green-dark);background:#f4f0e6}.reject{margin-top:.6rem;color:white;background:transparent;border:1px solid rgba(255,255,255,.55)}.status{min-height:1.4rem;margin-top:1rem;color:#f0c07e!important;font-size:.76rem!important}@media(max-width:760px){.cookie-layout{grid-template-columns:1fr}}</style>
