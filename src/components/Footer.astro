---
// Design System: Pendopo & Peta Kota — a source-aware bilingual civic footer with the route motif on every page.
const en = Astro.url.pathname.startsWith("/en");
const privacy = en ? "/en/privacy/" : "/kebijakan-privasi/";
const terms = en ? "/en/terms/" : "/syarat-ketentuan/";
const cookies = en ? "/en/cookies/" : "/pengaturan-cookie/";
---
<footer class="site-footer"><div style="display:flex;align-items:center;gap:1rem;margin:0 0 2.2rem;padding-bottom:1.15rem;border-bottom:1px solid rgba(244,240,230,.22)"><img src="/generated/alun-alun-pandeglang-mark.webp" width="54" height="54" alt="" style="width:3.2rem;height:3.2rem;object-fit:contain" /><div style="min-width:0"><p style="margin:0;color:#f0c07e;font-size:.62rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase">{en ? "Visitor route · orientation point" : "Jalur kunjungan · titik orientasi"}</p><p style="margin:.1rem 0 0;font-size:.72rem;font-weight:700;letter-spacing:.08em">06°18′35″S&nbsp;&nbsp;—&nbsp;&nbsp;106°06′24″E&nbsp;&nbsp;·&nbsp;&nbsp;Jl. KH. Abdul Halim</p></div><img src="/generated/pandeglang-compass-ribbon.webp" alt="" style="margin-left:auto;width:min(25vw,220px);height:3rem;object-fit:contain;opacity:.86" /></div><div class="footer-top"><div><p class="footer-kicker">{en ? "Public guide · Pandeglang, Banten" : "Panduan publik · Pandeglang, Banten"}</p><h2>{en ? "Open space, read with context." : "Ruang terbuka, dibaca dengan konteks."}</h2></div><div class="footer-links"><a href={privacy}>{en ? "Privacy Policy" : "Kebijakan Privasi"}</a><a href={terms}>{en ? "Terms of Use" : "Syarat & Ketentuan"}</a><a href={cookies}>{en ? "Cookie Settings" : "Pengaturan Cookie"}</a></div></div><div class="footer-notes"><p><strong>{en ? "Unofficial notice." : "Penafian nonresmi."}</strong> {en ? "This is an independent, non-profit visitor guide and is not affiliated with any government, operator or official organisation." : "Situs ini merupakan proyek panduan pengunjung independen dan nirlaba; tidak berafiliasi dengan pemerintah, pengelola, atau organisasi resmi mana pun."}</p><p>{en ? "Context references dated publications from Pandeglang’s Regional Secretariat and Health Office. This guide contains no commercial recommendations." : "Konteks merujuk pada publikasi bertanggal Sekretariat Daerah dan Dinas Kesehatan Pandeglang. Tidak ada rekomendasi komersial dalam panduan ini."}</p><p>{en ? "Project-made illustrations are decorative and do not document current site conditions. Use source links to check visitor information." : "Ilustrasi proyek bersifat dekoratif dan tidak mendokumentasikan kondisi lokasi sekarang. Gunakan tautan sumber untuk memeriksa informasi kunjungan."}</p></div><div class="footer-bottom"><span>© 2026 {en ? "Alun-Alun Pandeglang Guide" : "Panduan Alun-Alun Pandeglang"}.</span><span>{en ? "Built for more context-aware travel information." : "Dibuat untuk informasi perjalanan yang lebih sadar konteks."}</span></div></footer>
<style>/* Design System: Pendopo & Peta Kota — dark ground, warm type, long reading rhythm. */.site-footer{padding:clamp(3rem,6vw,5rem) clamp(1.25rem,5vw,5rem) 1.8rem;background:#173d2e;color:#f4f0e6}.footer-top{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(14rem,.8fr);gap:3rem;padding-bottom:3rem;border-bottom:1px solid rgba(244,240,230,.22)}.footer-kicker{margin:0 0 .8rem;color:#f0c07e;font-size:.68rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase}h2{max-width:17ch;font-size:clamp(2rem,3.8vw,3.55rem)}.footer-links{display:grid;align-content:end;gap:.7rem;font-size:.82rem;font-weight:700}.footer-links a{min-height:44px;display:inline-flex;align-items:center;width:fit-content;border-bottom:1px solid rgba(244,240,230,.4);padding-bottom:.17rem}.footer-links a:hover{color:#f0c07e}.footer-notes{display:grid;grid-template-columns:repeat(3,1fr);gap:1.65rem;padding:2rem 0;color:rgba(244,240,230,.76);font-size:.76rem;line-height:1.8}.footer-notes strong{color:white}.footer-bottom{display:flex;justify-content:space-between;gap:1rem;padding-top:1.25rem;border-top:1px solid rgba(244,240,230,.22);color:rgba(244,240,230,.55);font-size:.68rem;letter-spacing:.04em}@media(max-width:740px){.footer-top,.footer-notes{grid-template-columns:1fr}.footer-bottom{display:grid}}</style>
