---
// Design System: Pendopo & Peta Kota — directional marker nav, dense civic header, green signature.
const isEnglish = Astro.url.pathname.startsWith("/en");
const isHome = isEnglish ? Astro.url.pathname === "/en/" : Astro.url.pathname === "/";
const homeHref = isEnglish ? "/en/" : "/";
const languageHref = isEnglish ? "/" : "/en/";
const mapAnchor = isEnglish ? "#map" : "#peta";
---
<header class="site-header"><a class="brand" href={homeHref} aria-label="Alun-Alun Pandeglang"><img src="/manus-storage/alun-alun-pandeglang-mark_9d0abfbf.png" width="52" height="52" alt="" /><span><strong>Alun-Alun</strong><em>Pandeglang</em></span></a><nav class="desktop-nav" aria-label={isEnglish ? "Primary navigation" : "Navigasi utama"}>{isHome ? (isEnglish ? <><a href="#about">About</a><a href="#plan">Plan</a><a href="#map">Map</a><a href="#faq">FAQ</a></> : <><a href="#tentang">Tentang</a><a href="#rencanakan">Rencanakan</a><a href="#peta">Peta</a><a href="#faq">FAQ</a></>) : <a href={homeHref}>{isEnglish ? "Back to guide" : "Kembali ke panduan"}</a>}</nav><div class="header-actions"><a class="language-switch" href={languageHref} hreflang={isEnglish ? "id" : "en"}>{isEnglish ? "ID" : "EN"}</a><a class="nav-cta" href={isHome ? mapAnchor : `${homeHref}${mapAnchor}`}>{isEnglish ? "Location" : "Arah lokasi"} <span aria-hidden="true">↗</span></a></div></header>
<style>/* Design System: Pendopo & Peta Kota — navigation reads like a municipal wayfinding sign. */.site-header{position:relative;z-index:5;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;padding:1.1rem clamp(1.25rem,5vw,4rem);border-bottom:1px solid rgba(244,240,230,.25);color:white;background:#173d2e}.brand{display:inline-flex;align-items:center;gap:.7rem;min-width:0}.brand img{width:2.45rem;height:2.45rem;object-fit:contain}.brand span{display:grid;line-height:.9;font-size:.9rem}.brand strong{font-family:"DM Serif Display",Georgia,serif;font-size:1.25rem;font-weight:400}.brand em{margin-top:.27rem;font-size:.62rem;font-style:normal;font-weight:800;letter-spacing:.17em;text-transform:uppercase}.desktop-nav{display:flex;justify-content:center;gap:clamp(.85rem,2vw,2rem);font-size:.72rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.desktop-nav a{opacity:.78;transition:opacity 150ms ease,color 150ms ease}.desktop-nav a:hover{color:#f0c07e;opacity:1}.header-actions{display:flex;align-items:center;gap:1rem}.language-switch{border:1px solid rgba(244,240,230,.55);padding:.32rem .42rem;color:#f0c07e;font-size:.64rem;font-weight:800;letter-spacing:.08em}.language-switch:hover{background:#f0c07e;color:#173d2e}.nav-cta{display:inline-flex;gap:.4rem;align-items:center;font-size:.71rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase}.nav-cta span{color:#f0c07e;font-size:1.1rem}@media(max-width:760px){.desktop-nav{display:none}.site-header{grid-template-columns:1fr auto}.nav-cta{font-size:.65rem}.header-actions{gap:.55rem}}</style>
