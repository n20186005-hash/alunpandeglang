---
// Design System: Pendopo & Peta Kota — English policy pages retain the same field-note orientation system as the guide.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
interface Props { kind: "privacy" | "terms" | "cookies"; }
const { kind } = Astro.props;
const content = {
  privacy: { title: "Privacy Policy", lead: "A plain-language account of the minimal data approach used by this independent visitor guide.", label: "Information document", sections: [["Information we collect", "We collect only the minimum data needed to operate this site. Technical data can include IP address, browser type, pages viewed and cookie-related settings. Information you choose to provide through a future contact channel may also be processed."], ["How information is used", "Information may help improve the guide, understand aggregated use, respond to requests and meet applicable legal obligations."], ["Third-party services", "Google Maps is used for the embedded map. Google Analytics loads only if you grant analytics consent. Each third party applies its own privacy terms."], ["Your choices", "You may change analytics consent at any time using Cookie Settings. For access, correction or erasure requests, use the contact route made available by the project."]] },
  terms: { title: "Terms of Use", lead: "The guide is independent, non-profit and provided for general visitor information.", label: "Information document", sections: [["Content use", "This site is an independent third-party travel information project. It is not affiliated with the attraction, government, commercial operators or a tourism authority."], ["Accuracy and change", "We aim to make useful, traceable information available, but routes, conditions, facilities and events can change. Confirm important details through official or local channels before travelling."], ["Intellectual property", "Original site content and design are protected. Photo rights remain with photographers or their rights holders. Google Maps use is subject to Google’s terms."], ["Limitation of liability", "The guide is provided as-is. We cannot accept responsibility for loss resulting from reliance on site information or travel decisions made from it."]] },
  cookies: { title: "Cookie Settings", lead: "Choose whether anonymised analytics may load on this device. Essential preferences remain available for the site to function.", label: "Your privacy", sections: [["Essential cookies", "These are needed for basic site operation and cannot be switched off."], ["Analytics", "When you opt in, Google Analytics may collect anonymised usage information to help us understand which guide pages are useful."], ["Preferences", "This site stores your cookie preference locally on your device."], ["Marketing", "This independent guide does not use personalised advertising or marketing cookies."]] }
}[kind];
---
<BaseLayout lang="en" pathname={kind === "privacy" ? "/en/privacy" : kind === "terms" ? "/en/terms" : "/en/cookies"} title={`${content.title} — Alun-Alun Pandeglang`} description={content.lead}><div class="site-shell"><Header /><main id="konten" class="policy"><p class="eyebrow">{content.label}</p><h1>{content.title}</h1><p class="lead">{content.lead}</p><div class="route-line"><span>06°18′35″S</span><i></i><span>106°06′14″E</span><b>EN</b></div><div class="policy-grid"><aside><p>Last updated</p><strong>August 2026</strong><a href="/en/">← Back to guide</a></aside><article>{content.sections.map(([heading, body]) => <section><h2>{heading}</h2><p>{body}</p></section>)}</article></div></main><Footer /></div></BaseLayout>
<style>/* Design System: Pendopo & Peta Kota — policy content follows a route line rather than a generic legal template. */.policy{padding:clamp(4rem,9vw,7rem) clamp(1.25rem,10vw,10rem);background:rgba(251,249,244,.9)}h1{max-width:12ch;margin:.8rem 0 1rem;font-size:clamp(3rem,7vw,6rem)}.lead{max-width:55ch;color:var(--ink-soft);font-size:1.05rem}.route-line{display:flex;align-items:center;gap:.65rem;margin-top:2.2rem;color:var(--green);font-size:.65rem;font-weight:800;letter-spacing:.1em}.route-line i{width:clamp(4rem,13vw,12rem);height:1px;background:currentColor}.route-line b{color:var(--clay)}.policy-grid{display:grid;grid-template-columns:.38fr 1fr;gap:clamp(2rem,9vw,8rem);margin-top:2rem;border-top:1px solid var(--line);padding-top:1.5rem}aside{align-self:start;color:var(--ink-soft);font-size:.76rem}aside strong{display:block;margin:.2rem 0 1.5rem;color:var(--green)}aside a{color:var(--green);font-weight:800}article{max-width:62ch}article section+section{margin-top:2.6rem}article h2{margin:0 0 .8rem;font-size:2rem}article p{color:var(--ink-soft)}@media(max-width:700px){.policy-grid{grid-template-columns:1fr}}</style>
