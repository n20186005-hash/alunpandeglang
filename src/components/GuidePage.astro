---
// Design System: Pendopo & Peta Kota — bilingual field-guide storytelling where evidence, route logic, and civic context lead the journey.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { SITE_NAME } from "../data/site";

interface Props { lang: "id" | "en"; }
const { lang } = Astro.props;
const en = lang === "en";
const path = en ? "/en/" : "/";
const t = (id: string, english: string) => en ? english : id;
const faqs = en ? [
  ["Where is Alun-Alun Pandeglang?", "The Maps listing places it on Jl. KH. Abdul Halim, Pandeglang, Banten 42211, Indonesia. Use the pin -6.3097349,106.1065409 and confirm the available drop-off and pedestrian access before travelling."],
  ["Is Alun-Alun Pandeglang suitable for a short visit?", "Yes. Treat it as a 30–60 minute civic pause: walk the open area, observe the town-centre rhythm and check whether a community event is under way."],
  ["Is there an entrance fee or fixed opening time?", "Google Maps listed 24-hour opening on all seven days when checked on 19 October 2026. This dated third-party listing does not guarantee night-time access or event arrangements. Current entrance or parking charges are not verified; follow notices and confirm locally."],
  ["Where should I find toilets, parking, food, or a place to stay?", "Use the practical checklist on this page and confirm availability on arrival. This guide lists service types, not individual businesses or endorsements."],
  ["How do I get here from the airport?", "Use Soekarno–Hatta as a major air gateway, then confirm the current long-distance bus, hire-car, taxi, or multi-stage route before travelling. Direct services and schedules can change."],
] : [
  ["Di mana lokasi Alun-Alun Pandeglang?", "Maps mencantumkan Jl. KH. Abdul Halim, Pandeglang, Banten 42211, Indonesia. Gunakan pin -6.3097349,106.1065409 dan konfirmasikan titik turun serta akses pejalan kaki sebelum berangkat."],
  ["Apakah Alun-Alun Pandeglang cocok untuk kunjungan singkat?", "Ya. Jadikan kunjungan 30–60 menit sebagai jeda sipil: berjalan di ruang terbuka, mengamati ritme pusat kota, dan melihat apakah ada kegiatan warga."],
  ["Apakah ada tiket masuk atau jam buka tetap?", "Google Maps mencantumkan buka 24 jam pada tujuh hari saat diperiksa 19 Oktober 2026. Catatan pihak ketiga bertanggal ini tidak menjamin akses malam atau pengaturan acara. Tarif masuk atau parkir saat ini belum terverifikasi; ikuti pengumuman dan konfirmasikan setempat."],
  ["Di mana mencari toilet, parkir, makan, atau tempat menginap?", "Gunakan daftar periksa praktis di halaman ini dan konfirmasi ketersediaan saat tiba. Panduan ini menjelaskan jenis layanan, bukan merekomendasikan usaha tertentu."],
  ["Bagaimana cara datang dari bandara?", "Gunakan Soekarno–Hatta sebagai pintu masuk udara besar, lalu konfirmasikan pilihan bus antarkota, kendaraan sewaan, taksi, atau rute bertahap sebelum berangkat. Layanan langsung dan jadwal dapat berubah."],
];

const attractionJsonLd = {
  "@context": "https://schema.org", "@type": "TouristAttraction", name: "Alun-Alun Pandeglang",
  url: Astro.site ? new URL(path, Astro.site).toString() : undefined,
  description: en ? "An independent visitor guide to the public town square in Pandeglang, Banten, Indonesia." : "Panduan pengunjung independen untuk ruang terbuka publik di Pandeglang, Banten, Indonesia.",
  address: { "@type": "PostalAddress", streetAddress: "Jl. KH. Abdul Halim", addressLocality: "Pandeglang", addressRegion: "Banten", postalCode: "42211", addressCountry: "ID" },
  geo: { "@type": "GeoCoordinates", latitude: -6.3097349, longitude: 106.1065409 }
};
const faqJsonLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) };
---
<BaseLayout lang={lang} pathname={path} title={SITE_NAME[lang]} description={t("Ruang terbuka publik di pusat Pandeglang, Banten. Lihat lokasi, catatan Maps bertanggal, konteks kegiatan, akses dan tips kunjungan singkat dalam satu panduan nirlaba.", "The public town square in Pandeglang, Banten, Indonesia. Find the location, dated Maps listing, civic-event context, access and short-visit tips in one independent guide.")}>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify([attractionJsonLd, faqJsonLd])}></script></Fragment>
  <div class="site-shell">
    <Header />
    <main id="konten">
      <section class="hero" aria-labelledby="guide-title">
        <div class="hero-copy">
          <p class="eyebrow reveal">Pandeglang · Banten · Indonesia</p>
          <h1 id="guide-title" class="reveal">{t("Alun-Alun Pandeglang, Banten.", "Alun-Alun Pandeglang, Banten.")}</h1>
          <p class="hero-lede reveal">{t("Panduan nirlaba ini membantu Anda tiba dengan lebih siap, memahami konteks ruang publik, dan membuat keputusan perjalanan tanpa rekomendasi komersial.", "This non-profit guide helps you arrive prepared, understand the public-space context and make travel decisions without commercial recommendations.")}</p>
          <div class="hero-actions reveal"><a class="button-primary" href="#arrival">{t("Rencanakan kunjungan", "Plan your visit")} <span aria-hidden="true">↓</span></a><a class="button-quiet" href="#map">{t("Buka peta", "Open map")}</a></div>
          <div class="hero-meta"><span>{t("Kunjungan ringkas", "Short visit")}</span><b>30–60 {t("menit", "minutes")}</b><span>·</span><span>{t("Pemeriksaan lokal dianjurkan", "Local checks recommended")}</span></div>
        </div>
        <div class="hero-images" aria-label={t("Ilustrasi dekoratif panduan, bukan foto lokasi", "Decorative guide illustrations, not location photographs")}>
          <figure class="hero-photo primary"><img src="/generated/pandeglang-morning-light.webp" alt={t("Ilustrasi cahaya pagi abstrak, bukan foto alun-alun", "Abstract morning-light illustration, not a photograph of the square")} /><figcaption>{t("Ilustrasi dekoratif proyek · bukan dokumentasi kondisi lokasi", "Project decorative illustration · not evidence of current site conditions")}</figcaption></figure>
          <figure class="hero-photo secondary"><img src="/generated/alun-alun-pandeglang-mark.webp" alt={t("Marka ilustratif panduan, bukan lambang resmi", "Illustrative guide mark, not an official emblem")} /></figure>
          <img class="botanical" src="/generated/pandeglang-botanical-corner.webp" alt="" />
        </div>
        <div class="hero-route" aria-label={t("Koordinat lokasi", "Location coordinates")}><span>06°18′35″S</span><i></i><span>106°06′24″E</span><b>01 · {t("Titik awal", "Start point")}</b></div>
      </section>

      <section id="about" class="section story-section">
        <div class="story-index"><span>02</span><p>{t("Konteks kota", "Town context")}</p></div>
        <div>
          <p class="eyebrow">{t("Mengapa alun-alun berarti", "Why the square matters")}</p>
          <h2 class="section-title">{t("Sebuah ruang publik yang dibaca bersama kota di sekitarnya.", "A public space best read together with the town around it.")}</h2>
          <p class="section-intro">{t("Alun-Alun Pandeglang adalah titik orientasi di Pandeglang, Banten. Publikasi pemerintah daerah mendokumentasikan kegiatan bersama di lapangan ini; kegiatan pada tanggal tertentu tidak berarti ada jadwal acara tetap untuk pengunjung.", "Alun-Alun Pandeglang is an orientation point in Pandeglang, Banten. Local-government publications document civic events at this square; an event held on a particular date does not establish a recurring visitor programme.")}</p>
          <div class="source-rail"><a href="https://ppid.pandeglangkab.go.id/home/profilpemkab">{t("Profil Kabupaten Pandeglang", "Pandeglang Regency profile")} ↗</a><a href="https://setda.pandeglangkab.go.id/posts/hut-ke-81-ri-jadi-momentum-percepatan-pembangunan-pandeglang-infrastruktur-dan-pendidikan-jadi-prioritas">{t("Catatan Pemkab · 17 Agustus 2026", "Regency record · 17 August 2026")} ↗</a></div>
        </div>
      </section>

      <section class="origin-section">
        <div class="origin-mark"><img src="/generated/alun-alun-pandeglang-mark.webp" alt="" /><span>03</span></div>
        <div><p class="eyebrow">{t("Kegiatan yang terdokumentasi", "Documented civic events")}</p><h2>{t("Catatan peristiwa, bukan kalender kegiatan rutin.", "Records of past events, not a recurring programme.")}</h2></div>
        <div class="origin-copy"><p>{t("Sekretariat Daerah mencatat upacara HUT ke-81 RI di Alun-Alun Pandeglang pada 17 Agustus 2026. Dinas Kesehatan juga mencatat kegiatan peringatan hari jadi Pandeglang di alun-alun pada 31 Maret 2026. Keduanya adalah peristiwa bertanggal; bukan bukti layanan kesehatan harian, pertunjukan tetap atau acara yang akan selalu tersedia.", "The Regional Secretariat records the 81st Independence Day ceremony at Alun-Alun Pandeglang on 17 August 2026. The Health Office also records a Pandeglang anniversary activity at the square on 31 March 2026. These are dated events, not evidence of daily health services, regular performances or a programme always available to visitors.")}</p><a class="source-link" href="https://dinkes.pandeglangkab.go.id/posts/sambutan-hari-jadi-ke-152-pandeglang-dinas-kesehatan-gelar-bakti-sosial-kesehatan-dan-sunatan-masal">{t("Dinas Kesehatan · 31 Maret 2026 ↗", "Health Office · 31 March 2026 ↗")}</a></div>
      </section>

      <section id="arrival" class="section arrival-section">
        <div class="arrival-heading"><p class="eyebrow">{t("Detail transportasi", "Getting here")}</p><h2 class="section-title">{t("Susun perjalanan dalam tiga tahap: pintu masuk, simpul transportasi, lalu sambungan terakhir.", "Plan in three stages: gateway, transport hub, then the last connection.")}</h2><p class="section-intro">{t("Jadwal dan layanan dapat berubah. Gunakan bagian ini untuk memilih jenis perjalanan, lalu konfirmasi rute aktif, biaya, titik turun, dan waktu pulang melalui operator atau petugas setempat.", "Schedules and services can change. Use this section to choose a travel type, then confirm active routes, fares, drop-off points and your return journey with the operator or local staff.")}</p></div>
        <div class="arrival-route">
          <article><span>A</span><h3>{t("Dari bandara", "From the airport")}</h3><p>{t("Bandara Internasional Soekarno–Hatta adalah pintu masuk udara besar yang lazim untuk perjalanan lanjut ke Banten. Dari bandara, periksa layanan bus antarkota yang sedang berjalan atau rencanakan rute darat bertahap melalui kawasan Serang; taksi dan kendaraan sewaan adalah alternatif menurut kebutuhan. Jangan mengandalkan layanan langsung tanpa konfirmasi hari keberangkatan.", "Soekarno–Hatta International Airport is a major air gateway for onward travel to Banten. From the airport, check live intercity bus options or plan a staged road route via the Serang area; taxis and hired vehicles are alternatives depending on your needs. Do not assume a direct service without confirming it for your travel date.")}</p></article>
          <article><span>B</span><h3>{t("Dengan bus antarkota", "By intercity bus")}</h3><p>{t("Tanyakan kepada operator bus tentang rute yang benar-benar berjalan ke Pandeglang pada tanggal perjalanan Anda. Konfirmasikan terminal tujuan, tarif, keberangkatan terakhir dan sambungan ke Jl. KH. Abdul Halim sebelum membeli tiket.", "Ask the bus operator which services actually run to Pandeglang on your travel date. Confirm the destination terminal, fare, last departure and onward connection to Jl. KH. Abdul Halim before buying a ticket.")}</p></article>
          <article><span>C</span><h3>{t("Taksi, ojek & kendaraan pribadi", "Taxi, ojek & private vehicle")}</h3><p>{t("Untuk sambungan terakhir, gunakan taksi, ojek, atau kendaraan pribadi sesuai ketersediaan. Sebutkan “Alun-Alun Pandeglang, Jl. KH. Abdul Halim” dan minta titik turun yang tidak mengganggu kegiatan. Jika berkendara, ikuti rambu dan arahan parkir saat tiba.", "For the final connection, use a taxi, motorcycle taxi (ojek) or private vehicle as available. State “Alun-Alun Pandeglang, Jl. KH. Abdul Halim” and ask for a drop-off point that does not obstruct activities. If driving, follow signs and parking directions on arrival.")}</p></article>
          <article><span>D</span><h3>{t("Kereta & rute campuran", "Rail & mixed routes")}</h3><p>{t("Jika perjalanan melibatkan kereta, periksa stasiun tujuan dan sambungan darat ke Pandeglang langsung melalui operator. Jangan menganggap ada layanan langsung sampai alun-alun; siapkan rencana perjalanan pulang.", "If your trip involves rail, check the destination station and road connection to Pandeglang with the operators. Do not assume a direct service to the square; arrange your return journey too.")}</p></article>
        </div>
      </section>

      <section id="essentials" class="section essentials-section">
        <div class="essentials-copy"><p class="eyebrow">{t("Kebutuhan pengunjung", "Visitor essentials")}</p><h2 class="section-title">{t("Cari jenis layanan yang Anda perlukan, bukan nama usaha yang harus dipilih.", "Look for the service type you need, not a business name you are told to choose.")}</h2><p class="section-intro">{t("Kami tidak mempromosikan atau memberi peringkat pedagang. Ketersediaan fasilitas dapat berubah menurut waktu, acara, dan kondisi setempat—periksa sebelum menggunakan atau meninggalkan kendaraan.", "We do not promote or rank businesses. Facility availability can change with time, events and local conditions—check before using a facility or leaving a vehicle.")}</p><div class="essentials-note"><strong>{t("Cara pakai", "How to use this")}</strong><p>{t("Saat tiba, baca penanda, periksa peta, dan tanyakan jenis layanan kepada petugas atau warga secara sopan. Simpan alternatif jika Anda berkunjung saat acara ramai.", "On arrival, read signs, check the map and politely ask staff or residents about service types. Keep an alternative plan for busy-event days.")}</p></div></div>
        <div class="essentials-grid">
          <article><span>01</span><h3>WC / {t("sanitasi", "sanitation")}</h3><p>{t("Cari toilet umum atau fasilitas sanitasi yang ditandai; konfirmasi akses, kebersihan, dan biaya bila ada.", "Look for marked public toilets or sanitation facilities; confirm access, cleanliness and any fee.")}</p></article>
          <article><span>02</span><h3>{t("Parkir", "Parking")}</h3><p>{t("Gunakan area resmi atau arahan petugas. Pada hari kegiatan, datang lebih awal dan jangan menghalangi jalur pejalan kaki atau akses darurat.", "Use official areas or staff direction. On event days, arrive earlier and do not block pedestrian or emergency access.")}</p></article>
          <article><span>03</span><h3>{t("Makan & minum", "Food & drink")}</h3><p>{t("Cari kategori warung makan, minuman, atau kebutuhan ringan di pusat kota. Pilih berdasarkan kebutuhan diet, kebersihan, dan jam aktual.", "Look for food-stall, drink and light-necessity categories around the town centre. Choose based on dietary needs, hygiene and live hours.")}</p></article>
          <article><span>04</span><h3>{t("Menginap", "Overnight stays")}</h3><p>{t("Untuk kunjungan lebih lama, bandingkan jenis akomodasi berdasarkan jarak, ulasan terbaru, akses mobilitas, dan kebutuhan keluarga Anda.", "For a longer stay, compare accommodation types by distance, recent reviews, mobility access and your family’s needs.")}</p></article>
          <article><span>05</span><h3>{t("Belanja & kesehatan", "Everyday needs & health")}</h3><p>{t("Cari toko kebutuhan harian, apotek, ATM, atau layanan kesehatan sesuai kebutuhan. Periksa jam buka langsung sebelum bergantung pada layanan.", "Look for everyday-goods shops, pharmacies, ATMs or health services as needed. Check live opening times before relying on them.")}</p></article>
          <article><span>06</span><h3>{t("Bahan bakar & pengisian", "Fuel & charging")}</h3><p>{t("Untuk perjalanan lanjut, rencanakan bahan bakar atau pengisian daya kendaraan lebih awal. Ketersediaan titik pengisian perlu diverifikasi pada peta terbaru.", "For onward travel, plan vehicle fuel or charging early. Charging-point availability must be checked on a current map.")}</p></article>
          <article><span>07</span><h3>{t("Akses & keluarga", "Access & families")}</h3><p>{t("Perhatikan permukaan, keramaian, cuaca, dan jarak jalan kaki. Jika memerlukan bantuan akses khusus, tanyakan kondisi hari itu sebelum datang.", "Consider surfaces, crowd levels, weather and walking distance. If you need specific access support, ask about the day’s conditions before arriving.")}</p></article>
          <article><span>08</span><h3>{t("Keselamatan ringan", "Light-touch safety")}</h3><p>{t("Simpan barang penting, gunakan titik temu bila berkelompok, dan ikuti arahan pengamanan atau penutupan sementara.", "Keep essentials secure, agree a meeting point when travelling in a group and follow safety direction or temporary closures.")}</p></article>
        </div>
      </section>

      <section id="plan" class="section field-notes">
        <div class="field-title"><p class="eyebrow">{t("Catatan kunjungan", "Visit notes")}</p><h2 class="section-title">{t("Datang dengan rencana sederhana; pulang dengan konteks yang lebih kaya.", "Arrive with a simple plan; leave with a richer context.")}</h2></div>
        <div class="field-grid"><article><span>01</span><h3>{t("Pilih waktu", "Choose your time")}</h3><p>{t("Pagi atau menjelang sore sering lebih nyaman untuk ruang terbuka. Sesuaikan dengan cuaca dan jangan menganggap suasana sepi saat ada agenda warga.", "Morning or late afternoon can be more comfortable in an open setting. Adjust to weather and do not assume a quiet atmosphere on civic-event days.")}</p></article><article><span>02</span><h3>{t("Siapkan durasi", "Allow time")}</h3><p>{t("Untuk berhenti singkat, 30–60 menit cukup. Tambahkan waktu bila Anda perlu mencari parkir, melihat acara, atau mengatur sambungan pulang.", "For a short stop, 30–60 minutes is sufficient. Add time for parking, observing an event or arranging your return connection.")}</p></article><article><span>03</span><h3>{t("Hormati kegiatan", "Respect events")}</h3><p>{t("Alun-alun adalah ruang bersama. Perhatikan kegiatan keagamaan, seremonial, olahraga, atau komunitas; jangan memasuki area yang dibatasi.", "The square is shared space. Notice religious, ceremonial, sport or community activity; do not enter restricted areas.")}</p></article><article><span>04</span><h3>{t("Bawa seperlunya", "Pack lightly")}</h3><p>{t("Air minum, perlindungan matahari/hujan, daya telepon, dan uang kecil dapat membantu. Kurangi sampah dan bawa pulang barang pribadi.", "Water, sun/rain protection, phone power and small cash can help. Minimise waste and take personal belongings away with you.")}</p></article></div>
      </section>

      <section id="map" class="section map-section"><div class="map-copy"><p class="eyebrow">{t("Titik orientasi", "Orientation point")}</p><h2 class="section-title">{t("Temukan lokasi, lalu baca lingkungan di sekitarnya.", "Find the location, then read the neighbourhood around it.")}</h2><p class="section-intro">{t("Tetapkan tujuan sebagai “Alun-Alun Pandeglang”. Sebelum berangkat, periksa kondisi jalan, titik turun, pengaturan kegiatan, dan tempat parkir pada peta terbaru.", "Set your destination as “Alun-Alun Pandeglang”. Before leaving, check road conditions, drop-off point, event arrangements and parking on a current map.")}</p><p class="map-snapshot">{t("Google Maps diperiksa 19 Oktober 2026: 4,4/5 dari 8.624 ulasan; tujuh hari tercantum buka 24 jam (WIB). Ini catatan pihak ketiga bertanggal, bukan jaminan akses malam, fasilitas atau acara. Biaya masuk dan parkir belum terverifikasi; periksa pemberitahuan setempat. Situs ini bukan situs resmi pengelola.", "Google Maps checked 19 October 2026: 4.4/5 from 8,624 reviews; all seven days listed as open 24 hours (WIB). This is a dated third-party listing, not a guarantee of night-time access, facilities or events. Entrance and parking charges are unverified; check local notices. This is not an official operator website.")}</p><div class="map-meta"><div><span>{t("Alamat", "Address")}</span><strong>Jl. KH. Abdul Halim, Pandeglang, Banten 42211</strong></div><div><span>{t("Koordinat", "Coordinates")}</span><strong>-6.3097349, 106.1065409</strong></div></div><a class="source-link" href="https://maps.app.goo.gl/pJAYMC46WkNCCuYm6" target="_blank" rel="noreferrer">{t("Buka di Google Maps ↗", "Open in Google Maps ↗")}</a></div><div class="map-frame"><iframe title="Alun-Alun Pandeglang map" src="https://maps.google.com/maps?q=-6.3097349,106.1065409&z=16&output=embed" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>

      <section id="faq" class="section faq-section"><div><p class="eyebrow">FAQ</p><h2 class="section-title">{t("Pertanyaan yang berguna sebelum singgah.", "Useful questions before you stop by.")}</h2><p class="section-intro">{t("Jawaban ini mendukung perencanaan awal dan tidak menggantikan pengumuman di lokasi, jadwal operator, atau informasi penyelenggara.", "These answers support initial planning and do not replace on-site notices, operator schedules or organiser information.")}</p></div><div class="faq-list">{faqs.map(([question, answer], index) => <details><summary><span>{String(index + 1).padStart(2, "0")}</span>{question}<b aria-hidden="true">+</b></summary><p>{answer}</p></details>)}</div></section>

      <section class="evidence-section"><div><p class="eyebrow">{t("Transparansi informasi", "Information transparency")}</p><h2>{t("Sumber, tingkat kepastian, dan batas panduan ini.", "Sources, confidence levels and this guide’s limits.")}</h2></div><div class="evidence-list"><article><span>{t("Dikaji", "Reviewed")}</span><p>{t("Lokasi dirujuk melalui Maps bertanggal; konteks kegiatan melalui Sekretariat Daerah dan Dinas Kesehatan Pandeglang. Sumber diperiksa 19 Oktober 2026. Ilustrasi di halaman bersifat dekoratif, bukan foto kondisi sekarang.", "Location uses a dated Maps listing; civic-event context uses the Regional Secretariat and Pandeglang Health Office. Sources checked 19 October 2026. Illustrations are decorative, not photographs of current conditions.")}</p></article><article><span>{t("Perlu konfirmasi", "Confirm locally")}</span><p>{t("Tarif, jadwal, rute aktif, akses toilet, parkir, layanan energi, dan kondisi acara tidak dianggap tetap. Periksa sebelum menggunakan layanan atau mengubah rencana perjalanan.", "Fares, schedules, active routes, toilet access, parking, energy services and event conditions are not treated as fixed. Check before using a service or changing your travel plan.")}</p></article><article><span>{t("Bukan rekomendasi", "Not an endorsement")}</span><p>{t("Tidak ada usaha, operator, tempat makan, hotel, toko, atau layanan tertentu yang direkomendasikan, diberi peringkat, atau menerima manfaat komersial dari situs ini.", "No business, operator, restaurant, hotel, shop or named service is recommended, rated or commercially supported by this site.")}</p></article></div></section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
/* Design System: Pendopo & Peta Kota — route-led civic editorial system, pendopo lines replace generic cards, documentary photos carry evidence. */
